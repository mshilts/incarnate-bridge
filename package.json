{
  "name": "@inc-realm/bridge",
  "version": "0.9.0",
  "description": "Open-source local game bridge and SSH transport control plane",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mshilts/incarnate-bridge.git"
  },
  "homepage": "https://github.com/mshilts/incarnate-bridge#readme",
  "bugs": {
    "url": "https://github.com/mshilts/incarnate-bridge/issues"
  },
  "bin": {
    "incarnate-bridge": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser-server": {
      "types": "./dist/browser-server.d.ts",
      "import": "./dist/browser-server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./incarnate": {
      "types": "./dist/incarnate.d.ts",
      "import": "./dist/incarnate.js"
    },
    "./local-bootstrap": {
      "types": "./dist/local-bootstrap.d.ts",
      "import": "./dist/local-bootstrap.js"
    },
    "./openssh": {
      "types": "./dist/openssh.d.ts",
      "import": "./dist/openssh.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "tests/",
    "src/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "npm run build && npm run test:unit && npm run browser:security-test",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run",
    "browser:security-test": "tsx src/browser-server-security-regression.ts",
    "browser:start": "tsx src/cli.ts browser start",
    "key:generate": "tsx src/cli.ts key generate",
    "key:inspect": "tsx src/cli.ts key inspect",
    "host:trust": "tsx src/cli.ts host trust",
    "account:create": "tsx src/cli.ts account create",
    "account:add-key": "tsx src/cli.ts account add-key",
    "account:list-keys": "tsx src/cli.ts account list-keys",
    "account:remove-key": "tsx src/cli.ts account remove-key"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
